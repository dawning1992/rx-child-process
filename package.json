{
  "name": "rx-child-process",
  "version": "1.0.0",
  "description": "Reactive child process utilities for Node.js, powered by RxJS.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "test:coverage": "vitest run --coverage",
    "demo:basic": "tsx examples/basic.ts",
    "demo:stream": "tsx examples/stream.ts",
    "demo:cancel": "tsx examples/cancel.ts",
    "demo:node": "tsx examples/node-code.ts",
    "demo:ipc": "tsx examples/ipc.ts",
    "bench": "tsx bench/bench.ts"
  },
  "keywords": [
    "rxjs",
    "child-process",
    "spawn",
    "fork",
    "observable",
    "cancellation"
  ],
  "license": "MIT",
  "peerDependencies": {
    "rxjs": "^7.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "rxjs": "7.5.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
